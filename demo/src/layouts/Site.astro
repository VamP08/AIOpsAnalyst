---
import "../styles/tokens.css";
import "../styles/base.css";
import { stats } from "../lib/data";

interface Props {
  title: string;
  description: string;
  current?: "home" | "how" | "measured" | "explore" | "live";
}
const { title, description, current } = Astro.props;

const nav = [
  { key: "how", href: "/how-it-works/", label: "How it works" },
  { key: "measured", href: "/measured/", label: "Measured" },
  { key: "explore", href: "/explore/", label: "Explore" },
  { key: "live", href: "/live/", label: "Live" },
] as const;

const generated = stats.generated.slice(0, 10);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{current === "home" ? title : `${title} · AIOpsAnalyst`}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#052414" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AIOpsAnalyst" />
  <meta property="og:title" content={current === "home" ? title : `${title} · AIOpsAnalyst`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
  <meta property="og:image" content={new URL("/og.png", Astro.site).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;900&family=Familjen+Grotesk:wght@400;500;600&family=Martian+Mono:wght@400;500&display=swap"
  />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="wrap bar">
      <a class="word" href="/" aria-current={current === "home" ? "page" : undefined}><img src="/logo.svg" alt="" width="32" height="32" />AIOpsAnalyst</a>
      <nav aria-label="Site">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href} aria-current={current === item.key ? "page" : undefined}>{item.label}</a></li>
          ))}
          <li class="gh-item"><a href="https://github.com/VamP08/AIOpsAnalyst">GitHub</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="foot">
    <div class="wrap cols">
      <p class="word"><img src="/logo-on-dark.svg" alt="" width="32" height="32" />AIOpsAnalyst</p>
      <p>Every number on this site comes from the exported corpus in <a href="/data/stats.json">/data</a>, generated <time datetime={generated}>{generated}</time>.</p>
      <ul>
        <li><a href="https://github.com/VamP08/AIOpsAnalyst">Source on GitHub</a></li>
        <li><a href="/measured/">How it was measured</a></li>
        <li><a href="/explore/">Every pile</a></li>
      </ul>
    </div>
  </footer>
</body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in oklab, var(--white) 94%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 4rem;
  }
  .word {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font: 700 1.05rem/1 var(--font-display);
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .word img { flex: none; }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    list-style: none;
    padding: 0;
  }
  nav a {
    font-weight: 500;
    text-decoration: none;
    padding-block: var(--space-2);
    border-bottom: 2px solid transparent;
  }
  nav a:hover { border-bottom-color: var(--mint); }
  nav a[aria-current="page"] { border-bottom: 3px solid var(--mint); }

  .foot {
    margin-top: var(--space-8);
    background: var(--panel);
    color: var(--panel-ink);
    padding-block: var(--space-7);
  }
  .foot .cols {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  .foot .word { color: var(--mint); }
  .foot p { max-width: 46ch; }
  .foot ul { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .foot a { color: var(--panel-ink); }
  .foot a:hover { color: var(--mint); text-decoration-color: var(--mint); }
  .foot :focus-visible { outline-color: var(--mint); }

  @media (max-width: 760px) {
    .bar { flex-direction: column; align-items: flex-start; padding-block: var(--space-3); gap: var(--space-2); }
    .top { position: static; }
    .gh-item { display: none; }
    nav ul { gap: var(--space-1) var(--space-4); }
    .foot .cols { grid-template-columns: 1fr; }
  }
</style>
