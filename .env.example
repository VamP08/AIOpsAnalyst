# Copy to .env and fill in. .env is gitignored; never commit real keys.

# LLM providers, tried in failover order. Any subset works; with none set,
# triage is unavailable and the pipeline stays deterministic-only.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Fine-grained PAT, "Public repositories (read-only)" — used for polling issues.
# Unauthenticated GitHub API allows only 60 requests/hour; a token allows 5,000.
GITHUB_TOKEN=
